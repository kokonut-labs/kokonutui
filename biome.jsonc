{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/core",
    "ultracite/react",
    "ultracite/next",
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ],
  "files": {
    // public/r and registry.json are written by scripts/build-registry.ts.
    "includes": ["!public/r", "!registry.json", "!.agents"]
  },
  "overrides": [
    {
      // shadcn primitives, kept as close to upstream as possible.
      "includes": ["components/ui/**"],
      "linter": {
        "rules": { "performance": { "noNamespaceImport": "off" } }
      }
    }
  ]
}
